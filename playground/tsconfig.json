{
	"extends": "../tsconfig.base.json",
	"compilerOptions": {
		"allowJs": true,
		"composite": false,
		"declaration": false,
		"declarationMap": false,
		"jsx": "react-jsx",
		"noEmit": true,
		"paths": {
			"@/*": [
				"../src/*"
			]
		},
		"types": [
			"bun-types",
			"react",
			"react-dom"
		]
	},
	"exclude": [
		"../node_modules",
		"../dist"
	],
	"include": [
		"**/*.ts",
		"**/*.tsx",
		"**/*.js",
		"**/*.d.ts",
		"../src/globals.d.ts"
	]
}
