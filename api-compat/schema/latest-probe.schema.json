{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://easeljs.org/schemas/latest-probe.schema.json",
  "title": "Latest-version API compatibility probe",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "generatedAt",
    "packages",
    "compatibility",
    "upgrades"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "generatedAt": { "type": "string", "minLength": 1 },
    "packages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "current", "latest", "changed"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "current": { "type": "string", "minLength": 1 },
          "latest": { "type": "string", "minLength": 1 },
          "changed": { "type": "boolean" }
        }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["before", "after"],
        "properties": {
          "before": {
            "$ref": "https://easeljs.org/schemas/diff-report.schema.json"
          },
          "after": {
            "$ref": "https://easeljs.org/schemas/diff-report.schema.json"
          }
        }
      }
    },
    "upgrades": {
      "type": "object",
      "additionalProperties": false,
      "required": ["easel", "three"],
      "properties": {
        "easel": {
          "$ref": "https://easeljs.org/schemas/version-diff.schema.json"
        },
        "three": {
          "type": "object",
          "additionalProperties": {
            "$ref": "https://easeljs.org/schemas/version-diff.schema.json"
          }
        }
      }
    }
  }
}
