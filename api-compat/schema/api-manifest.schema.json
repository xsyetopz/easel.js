{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://easeljs.org/schemas/api-manifest.schema.json",
  "title": "EASEL and three.js normalized API manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "manifestVersion",
    "package",
    "surface",
    "exports",
    "symbols",
    "provenance"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "manifestVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "surface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "entrypoint", "sourceRoot"],
      "properties": {
        "id": {
          "enum": [
            "easel",
            "three-core",
            "three-addons",
            "three-webgpu",
            "three-tsl"
          ]
        },
        "name": { "type": "string", "minLength": 1 },
        "entrypoint": { "type": "string", "minLength": 1 },
        "sourceRoot": { "type": "string", "minLength": 1 }
      }
    },
    "exports": { "type": "array", "items": { "$ref": "#/$defs/export" } },
    "symbols": { "type": "array", "items": { "$ref": "#/$defs/symbol" } },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["extractor", "compiler", "entrypoint", "files"],
      "properties": {
        "extractor": { "type": "string", "minLength": 1 },
        "compiler": { "type": "string", "minLength": 1 },
        "entrypoint": { "type": "string", "minLength": 1 },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "hash"],
            "properties": {
              "path": { "type": "string" },
              "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "export": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "id", "kind"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "id": { "type": "string", "minLength": 1 },
        "kind": {
          "enum": [
            "class",
            "interface",
            "enum",
            "function",
            "variable",
            "constant",
            "type",
            "namespace",
            "unknown"
          ]
        },
        "source": { "type": "string" }
      }
    },
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type", "optional", "rest"],
      "properties": {
        "name": { "type": "string" },
        "type": { "type": "string" },
        "optional": { "type": "boolean" },
        "rest": { "type": "boolean" },
        "default": { "type": "string" }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parameters"],
      "properties": {
        "parameters": {
          "type": "array",
          "items": { "$ref": "#/$defs/parameter" }
        },
        "returnType": { "type": "string" },
        "typeParameters": {
          "type": "array",
          "items": { "$ref": "#/$defs/typeParameter" }
        }
      }
    },
    "member": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "kind", "scope", "optional", "readonly", "static"],
      "properties": {
        "name": { "type": "string" },
        "kind": {
          "enum": [
            "property",
            "accessor",
            "method",
            "constructor",
            "call",
            "index"
          ]
        },
        "scope": { "enum": ["instance", "static", "type"] },
        "optional": { "type": "boolean" },
        "readonly": { "type": "boolean" },
        "static": { "type": "boolean" },
        "type": { "type": "string" },
        "access": { "enum": ["get", "set", "get-set"] },
        "signatures": {
          "type": "array",
          "items": { "$ref": "#/$defs/signature" }
        },
        "declarationCount": { "type": "integer", "minimum": 1 },
        "deprecated": { "type": "string" }
      }
    },
    "typeParameter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "constraint": { "type": "string" },
        "default": { "type": "string" }
      }
    },
    "symbol": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "kind",
        "exportKind",
        "extends",
        "implements",
        "typeParameters",
        "constructors",
        "signatures",
        "members"
      ],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "kind": { "$ref": "#/$defs/kind" },
        "exportKind": { "enum": ["named", "default", "namespace"] },
        "module": { "type": "string" },
        "extends": { "type": "array", "items": { "type": "string" } },
        "implements": { "type": "array", "items": { "type": "string" } },
        "typeParameters": {
          "type": "array",
          "items": { "$ref": "#/$defs/typeParameter" }
        },
        "constructors": {
          "type": "array",
          "items": { "$ref": "#/$defs/signature" }
        },
        "signatures": {
          "type": "array",
          "items": { "$ref": "#/$defs/signature" }
        },
        "members": { "type": "array", "items": { "$ref": "#/$defs/member" } },
        "type": { "type": "string" },
        "deprecated": { "type": "string" },
        "description": { "type": "string" },
        "source": { "type": "string" }
      }
    },
    "kind": {
      "enum": [
        "class",
        "interface",
        "enum",
        "function",
        "variable",
        "constant",
        "type",
        "namespace",
        "unknown"
      ]
    }
  }
}
