# Cloudflare Pages deployment (Direct Upload via wrangler-action)
# Add these as GitHub repo secrets: Settings → Secrets and variables → Actions
#
# Account ID: dash.cloudflare.com → Account home → menu button on account row →
#             Copy account ID
#             (or: Overview page → API section at bottom)
#
# API Token:  dash.cloudflare.com → Manage Account → API Tokens → Create Token
#             Template: "Edit Cloudflare Workers" or Custom token with:
#             Permissions: Account / Cloudflare Pages / Edit
#             Account Resources: Include / <your account>

CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
