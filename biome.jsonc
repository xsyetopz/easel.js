{
	"$schema": "https://biomejs.dev/schemas/2.5.6/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"includes": [
			"**/*.{js,jsx,mjs,cjs,ts,tsx,mts,cts,json,jsonc}",
			"!!**/node_modules",
			"!!**/dist",
			"!!**/coverage",
			"!!www/astro/content/docs/docs",
			"!!.agents/skills/**/assets/templates",
			"!!**/*.generated.{js,jsx,mjs,cjs,ts,tsx,mts,cts}"
		],
		"ignoreUnknown": true
	},
	"formatter": {
		"enabled": false,
		"indentStyle": "tab"
	},
	"assist": {
		"enabled": false
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended"
		}
	},
	"javascript": {
		"globals": ["Bun"],
		"formatter": {
			"quoteStyle": "double"
		}
	},
	"css": {
		"linter": {
			"enabled": true
		}
	}
}
