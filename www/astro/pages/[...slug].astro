---
import "../../styles/main.scss";
import Layout from "../../components/Layout.astro";
import Home from "../../pages/Home.astro";
import ExamplesGallery from "../../pages/ExamplesGallery.astro";
import ExampleViewer from "../../pages/ExampleViewer.astro";
import LandingPage from "../../pages/LandingPage.astro";
import {
	buildExampleRouteData,
	loadExampleCatalog,
	loadExampleModule,
} from "../../loaders/examples";
import { loadStaticRouteEntries } from "../staticRoutes";

export async function getStaticPaths() {
	const entries = await loadStaticRouteEntries();
	return entries.map((entry) => ({
		params: {
			slug: entry.path === "/" ? undefined : entry.path.slice(1),
		},
		props: entry,
	}));
}

const { route, metadata } = Astro.props;
const catalog = route.page === "examples" || route.page === "example"
	? await loadExampleCatalog()
	: undefined;
const exampleModule = route.page === "example" ? await loadExampleModule(route.param) : null;
const example = exampleModule ? buildExampleRouteData(exampleModule) : null;
---

<Layout metadata={metadata} route={route} catalog={catalog} activeExampleId={route.page === "example" ? route.param : undefined}>
	{route.page === "home" && <Home />}
	{route.page === "examples" && catalog && <ExamplesGallery catalog={catalog} />}
	{route.page === "example" && catalog && <ExampleViewer exampleId={route.param} catalog={catalog} example={example} />}
	{route.page === "landing" && <LandingPage slug={route.slug} />}
</Layout>
