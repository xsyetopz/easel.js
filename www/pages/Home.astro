---
import { routeToPath } from "../routes";
import CodeExampleTabs from "../components/CodeExampleTabs.astro";
import FeatureCard from "../components/FeatureCard.astro";
import InstallTabs from "../components/InstallTabs.astro";

const capabilities = [
	{
		className: "bento-card",
		icon: "fa-solid fa-display-code",
		title: "Canvas2D output",
		text: "Frames land in ImageData on a standard canvas. No WebGL state or GPU lifecycle.",
	},
	{
		className: "bento-card bento-card-wide",
		icon: "fa-solid fa-microchip",
		title: "Pipeline stages you can inspect",
		text: "Traversal, ordering, light bake, scanline fill, CPU depth tests, and framebuffer upload stay readable.",
	},
	{
		className: "bento-card bento-card-wide",
		icon: "fa-solid fa-diagram-project",
		title: "Plain scene objects",
		text: "Scene, Mesh, Camera, Light, Material, and Geometry stay readable while the renderer remains CPU-only.",
	},
	{
		className: "bento-card",
		icon: "fa-solid fa-ruler-combined",
		title: "Renderer limits are explicit",
		text: "Camera tradeoffs, affine UVs, sorted transparency, and discrete opacity are documented.",
	},
	{
		className: "bento-card",
		icon: "fa-solid fa-box-archive",
		title: "Small package",
		text: "Zero runtime dependencies, typed surface, npm and JSR distribution.",
	},
];

const pipeline = ["SceneTraversal", "PainterSort", "LightBaker", "Rasterizer", "Framebuffer", "Canvas upload"];
const pipelineLoop = ["first", "second"].flatMap((pass) => pipeline.map((stage) => ({ key: `${pass}-${stage}`, stage })));
const constraints = [
	{ title: "Baked lighting", text: "Flat and Gouraud shading happen before rasterization." },
	{ title: "Camera tradeoffs", text: "Orthographic keeps affine UVs exact; perspective is available with visible texture warp." },
	{ title: "Depth is explicit", text: "Opaque fragments use a CPU depth buffer; transparent materials still need sorted order." },
	{ title: "Discrete blending", text: "Opacity uses fixed steps instead of fragile float alpha paths." },
];

interface FooterLink {
	label: string;
	href: string;
	external?: boolean | undefined;
}

interface FooterSection {
	title: string;
	links: FooterLink[];
}

const currentYear = new Date().getFullYear();
const footerSections: FooterSection[] = [
	{
		title: "Product",
		links: [
			{ label: "Examples", href: routeToPath("examples") },
			{ label: "API docs", href: routeToPath("docs") },
			{ label: "THREE.js comparison", href: routeToPath("compare/threejs") },
			{ label: "CPU rasterizer guide", href: routeToPath("cpu-rasterizer") },
		],
	},
	{
		title: "Packages",
		links: [
			{ label: "npm", href: "https://www.npmjs.com/package/@xsyetopz/easel", external: true },
			{ label: "JSR", href: "https://jsr.io/@xsyetopz/easel", external: true },
			{ label: "GitHub source", href: "https://github.com/xsyetopz/easel.js", external: true },
			{ label: "Report an issue", href: "https://github.com/xsyetopz/easel.js/issues", external: true },
		],
	},
	{
		title: "Project",
		links: [
			{ label: "Contributing", href: "https://github.com/xsyetopz/easel.js/blob/main/CONTRIBUTING.md", external: true },
			{ label: "Code of Conduct", href: "https://github.com/xsyetopz/easel.js/blob/main/CODE_OF_CONDUCT.md", external: true },
			{ label: "MIT License", href: "https://github.com/xsyetopz/easel.js/blob/main/LICENSE", external: true },
		],
	},
	{
		title: "Reference",
		links: [
			{ label: "Canvas software renderer", href: routeToPath("canvas-software-renderer") },
			{ label: "Canvas2D comparison", href: routeToPath("compare/easeljs") },
			{ label: "Renderer API", href: routeToPath("docs/Renderer") },
		],
	},
];
---

<div class="site-shell page-home">
	<section class="hero-section">
		<div class="container container-xl">
			<div class="stack stack-xl" style="align-items: center; text-align: center;">
				<h1 class="hero-title hero-title-center">Software 3D for browser Canvas2D.</h1>
				<p class="hero-copy hero-copy-center">
					EASEL.js gives JavaScript teams a renderer they can read: THREE-style objects, CPU rasterization, and deterministic canvas pixels.
				</p>
				<div class="group group-center hero-actions">
					<a href={routeToPath("examples")} class="button primary-button">
						<i class="fa-solid fa-cube" aria-hidden="true"></i>
						View examples
					</a>
					<a href={routeToPath("docs")} class="button secondary-button">
						<i class="fa-solid fa-book" aria-hidden="true"></i>
						Read docs
					</a>
				</div>
				<div class="pipeline-marquee" aria-hidden="true">
					<div>{pipelineLoop.map((item) => <span>{item.stage}</span>)}</div>
				</div>
			</div>
		</div>
	</section>

	<section class="content-section compact-section">
		<div class="container container-xl">
			<div class="bento-grid">
				{capabilities.map((item) => <FeatureCard className={item.className} icon={item.icon} title={item.title} text={item.text} />)}
			</div>
		</div>
	</section>

	<section class="content-section pipeline-chapter">
		<div class="container container-xl">
			<div class="grid" style="align-items: center;">
				<div class="grid-col-5 stack stack-md">
					<h2>Built for constrained renderers.</h2>
					<p class="section-copy">The renderer keeps the hard parts visible: stage timing, draw order, raster output, and framebuffer state.</p>
				</div>
				<div class="grid-col-7">
					<div class="constraint-accordion">
						{constraints.map((constraint) => (
							<article class="constraint-slice">
								<h3>{constraint.title}</h3>
								<p>{constraint.text}</p>
							</article>
						))}
					</div>
				</div>
			</div>
		</div>
	</section>

	<section class="content-section action-section">
		<div class="container container-xl">
			<div class="grid" style="align-items: center;">
				<div class="grid-col-5 stack stack-md">
					<h2>Install it. Read the pipeline.</h2>
					<p class="section-copy">Docs, source snippets, and rendered examples stay crawlable. Live editing belongs in a separate app surface.</p>
					<InstallTabs />
				</div>
				<div class="grid-col-7">
					<CodeExampleTabs />
				</div>
			</div>
		</div>
	</section>

	<footer class="site-footer" aria-label="EASEL.js footer">
		<div class="container container-xl">
			<div class="site-footer-top">
				<div class="site-footer-brand">
					<a href={routeToPath("")} class="site-footer-mark">EASEL.js</a>
					<p>
						Canvas2D software renderer for browser-side 3D scenes. CPU rasterization,
						plain TypeScript APIs, crawlable docs, and examples with source beside the canvas.
					</p>
					<div class="site-footer-pills" aria-label="Package registries">
						<a href="https://www.npmjs.com/package/@xsyetopz/easel" target="_blank" rel="noreferrer" aria-label="npm package" title="npm package">
							<i class="fa-brands fa-npm" aria-hidden="true"></i>
							<span class="sr-only">npm package</span>
						</a>
						<a href="https://jsr.io/@xsyetopz/easel" target="_blank" rel="noreferrer" aria-label="JSR package" title="JSR package">
							<svg class="site-footer-jsr-icon" viewBox="0 0 13 7" aria-hidden="true">
								<path fill="#083344" d="M0 6h4v1h7V5h2V1H9V0H2v2H0"></path>
								<path fill="#f7df1e" d="M4 5V1H3v3H2V3H1v2h6V4H5V1h3v1h4v2h-1V3h-1v3H9V2H6v1h2v3H5V5"></path>
							</svg>
							<span class="sr-only">JSR package</span>
						</a>
						<a href="https://github.com/xsyetopz/easel.js" target="_blank" rel="noreferrer" aria-label="GitHub repository" title="GitHub repository">
							<i class="fa-brands fa-github" aria-hidden="true"></i>
							<span class="sr-only">GitHub repository</span>
						</a>
					</div>
				</div>
				<div class="site-footer-columns">
					{footerSections.map((section) => (
						<div class="site-footer-group">
							<h2>{section.title}</h2>
							<ul>
								{section.links.map((link) => (
									<li>
										<a href={link.href} target={"external" in link && link.external ? "_blank" : undefined} rel={"external" in link && link.external ? "noreferrer" : undefined}>
											{link.label}
										</a>
									</li>
								))}
							</ul>
						</div>
					))}
				</div>
			</div>
			<div class="site-footer-bottom">
				<p>© {currentYear} xsyetopz. Released under the MIT License.</p>
				<p>TypeScript blue is used with attribution to the TypeScript project and Microsoft.</p>
			</div>
		</div>
	</footer>
</div>
