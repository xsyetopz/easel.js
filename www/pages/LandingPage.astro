---
import { landingPagesBySlug } from "../content/landingPages";

interface Props {
	slug: string;
}

const { slug } = Astro.props;
const page = landingPagesBySlug[slug];
---

<div class="site-shell">
	<div class="container container-lg" style="padding-block: 4.75rem;">
		{page ? (
			<div class="stack" style="gap: 3.4rem;">
				<section>
					<h1 class="hero-title">{page.title}</h1>
					<p class="hero-copy" style="margin-top: 1rem;">{page.intro}</p>
					<div class="group hero-actions" style="margin-top: 1.25rem;">
						{page.ctas.map((cta, index) => (
							<a href={cta.href} class:list={["button", index === 0 ? "primary-button" : "secondary-button"]}>{cta.label}</a>
						))}
					</div>
				</section>

				{page.sections.map((section) => (
					<article class="site-card stack stack-sm">
						<h2>{section.title}</h2>
						{section.body.map((paragraph) => <p class="section-copy">{paragraph}</p>)}
						{section.bullets && (
							<ul>
								{section.bullets.map((bullet) => <li>{bullet}</li>)}
							</ul>
						)}
					</article>
				))}

				<a href="/examples">Browse examples</a>
			</div>
		) : (
			<p class="section-copy">Page not found.</p>
		)}
	</div>
</div>
