---
interface Props {
	section?: "docs" | "examples" | "manual" | undefined;
}

const { section } = Astro.props as Props;
const links = [
	{ label: "Docs", href: "/docs/", section: "docs" as const },
	{ label: "Examples", href: "/examples/", section: "examples" as const },
	{ label: "Manual", href: "/manual/", section: "manual" as const },
];
---

<header class="site-header">
	<div class="site-container site-header__inner">
		<a class="site-wordmark" href="/" aria-label="EASEL.js home">EASEL.js</a>
		<nav class="site-primary-nav" aria-label="Primary">
			<ul>
				{links.map((link) => (
					<li>
						<a href={link.href} aria-current={section === link.section ? "page" : undefined}>
							{link.label}
						</a>
					</li>
				))}
				<li>
					<a href="https://github.com/xsyetopz/easel.js">GitHub</a>
				</li>
			</ul>
		</nav>
	</div>
</header>
