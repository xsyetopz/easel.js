---
import CodeBlock from "./CodeBlock.astro";
import TabsScript from "./TabsScript.astro";

interface Props {
	easelSource: string;
	threeSource?: string | undefined;
	noThreeReason?: string | undefined;
}

const { easelSource, threeSource, noThreeReason } = Astro.props;
const hasComparison = threeSource !== undefined;
---

<div class="stack stack-xs">
	{hasComparison ? (
		<div class="tabs" data-tabs>
			<div class="tabs-list" role="tablist" aria-label="Code comparison">
				<button class="tabs-tab" type="button" role="tab" aria-selected="true" data-tab-target="easel" data-engine-tab="easel">EASEL.js</button>
				<button class="tabs-tab" type="button" role="tab" aria-selected="false" data-tab-target="three" data-engine-tab="three">THREE.js</button>
			</div>
			<div class="tabs-panel" role="tabpanel" data-tab-panel="easel">
				<CodeBlock code={easelSource} language="javascript" />
			</div>
			<div class="tabs-panel" role="tabpanel" data-tab-panel="three" hidden>
				<CodeBlock code={threeSource ?? ""} language="javascript" />
			</div>
		</div>
	) : (
		<>
			<CodeBlock code={easelSource} language="javascript" />
			{noThreeReason && <p class="section-copy" style="font-size: 0.78rem;">No direct THREE.js equivalent: {noThreeReason}</p>}
		</>
	)}
</div>
<TabsScript />
