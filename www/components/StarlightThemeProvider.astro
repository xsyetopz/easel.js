<script is:inline>
  (() => {
    const media = window.matchMedia("(prefers-color-scheme: dark)");
    const apply = () => {
      document.documentElement.dataset.theme = media.matches ? "dark" : "light";
    };

    apply();
    media.addEventListener("change", apply);
  })();
</script>

