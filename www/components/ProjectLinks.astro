---
interface Props {
	compact?: boolean | undefined;
}

const { compact = false } = Astro.props as Props;
const links = [
	{
		label: "GitHub",
		href: "https://github.com/xsyetopz/easel.js",
		icon: "github",
	},
	{
		label: "npm",
		href: "https://www.npmjs.com/package/@xsyetopz/easel",
		icon: "npm",
	},
	{
		label: "JSR",
		href: "https://jsr.io/@xsyetopz/easel",
		icon: "jsr",
	},
] as const;
---

<ul class:list={["project-links", { "project-links--compact": compact }]}>
	{links.map(({ label, href, icon }) => (
		<li>
			<a href={href} rel="noreferrer" aria-label={`${label}: @xsyetopz/easel`}>
				{icon === "github" && (
					<svg viewBox="0 0 24 24" aria-hidden="true">
						<path d="M12 .7a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2.23c-3.22.7-3.9-1.37-3.9-1.37-.53-1.34-1.29-1.7-1.29-1.7-1.05-.72.08-.71.08-.71 1.16.08 1.78 1.2 1.78 1.2 1.04 1.77 2.72 1.26 3.39.96.1-.75.4-1.26.73-1.55-2.57-.29-5.27-1.29-5.27-5.68 0-1.25.45-2.28 1.19-3.08-.12-.29-.52-1.46.11-3.04 0 0 .97-.31 3.16 1.18A10.95 10.95 0 0 1 12 6.16c.98 0 1.95.13 2.86.38 2.2-1.49 3.16-1.18 3.16-1.18.63 1.58.23 2.75.12 3.04.74.8 1.18 1.83 1.18 3.08 0 4.4-2.71 5.38-5.29 5.67.42.36.79 1.06.79 2.14v3.26c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .7Z" />
					</svg>
				)}
				{icon === "npm" && (
					<svg viewBox="0 0 24 24" aria-hidden="true">
						<path d="M2 5h20v14h-10v-9H9v9H2V5Zm4 3v8h1V8H6Zm9 0v8h4V8h-4Z" />
					</svg>
				)}
				{icon === "jsr" && (
					<svg viewBox="0 0 24 24" aria-hidden="true">
						<path d="M3 4h18v16H3V4Zm3 4v5h3v3H6v-2h1v1h1v-6H6V8Zm5 0v5h3v2h-3v1h4v-4h-3V9h3V8h-4Zm6 0v8h1v-3h1l1 3h1l-1.1-3.3c.7-.4 1.1-1.1 1.1-2.1C21 8.9 20.1 8 18.5 8H17Zm1 1h.5c1 0 1.5.5 1.5 1.5S19.5 12 18.5 12H18V9Z" />
					</svg>
				)}
				<span>{label}</span>
			</a>
		</li>
	))}
</ul>

<style>
	.project-links {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.25rem 0.75rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.project-links a {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		min-block-size: 2.25rem;
		padding: 0.3rem 0.2rem;
		color: inherit;
		font-size: 0.9rem;
		font-weight: 600;
		text-decoration: none;
	}

	.project-links a:hover {
		color: var(--color-accent-strong, var(--sl-color-text-accent));
	}

	.project-links svg {
		inline-size: 1.1rem;
		block-size: 1.1rem;
		flex: none;
		fill: currentColor;
	}

	.project-links--compact {
		gap: 0.15rem 0.55rem;
	}

	.project-links--compact a {
		font-size: 0.82rem;
	}
</style>
