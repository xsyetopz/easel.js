---
import FeatureCard from "./FeatureCard.astro";
import { routeToPath } from "../routes";
import type { ExampleMeta } from "../loaders/examples.ts";

interface Props {
	meta: ExampleMeta;
}

const { meta } = Astro.props;
const categoryIcons: Record<string, string> = {
	misc: "fa-solid fa-cubes",
};
const icon = categoryIcons[meta.category] ?? "fa-solid fa-cube";
---

<FeatureCard href={routeToPath(`examples/${meta.id}`)} className="example-card" icon={icon} title={meta.name} text={meta.description} />
