---
import Search from "virtual:starlight/components/Search";

const currentPath = Astro.url.pathname.replace(/\/+$/u, "") || "/";
const navigation = [
  { href: "/docs/", label: "Docs" },
  { href: "/examples/", label: "Examples" },
  { href: "/manual/", label: "Manual" },
  { href: "https://github.com/xsyetopz/easel.js", label: "GitHub" },
];

function isCurrent(href: string): boolean {
  if (!href.startsWith("/")) return false;
  const normalized = href.replace(/\/+$/u, "") || "/";
  return normalized === "/docs"
    ? currentPath === "/docs" || currentPath.startsWith("/docs/")
    : normalized === "/manual"
      ? currentPath === "/manual" || currentPath.startsWith("/manual/")
      : normalized === "/examples"
        ? currentPath === "/examples" || currentPath.startsWith("/examples/")
        : currentPath === normalized;
}
---

<div class="starlight-header-content">
  <a class="starlight-brand" href="/" aria-label="EASEL.js home">EASEL.js</a>
  <nav class="starlight-global-nav" aria-label="Primary">
    <ul>
      {
        navigation.map(({ href, label }) => (
          <li>
            <a
              href={href}
              aria-current={isCurrent(href) ? "page" : undefined}
              rel={href.startsWith("http") ? "noreferrer" : undefined}
            >
              {label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
  <div class="starlight-search">
    <Search />
  </div>
</div>
