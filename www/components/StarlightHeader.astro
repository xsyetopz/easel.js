---
import Search from "virtual:starlight/components/Search";
import { sitePath, sitePathname } from "../utils/site-path.ts";

const currentPath = sitePathname(Astro.url.pathname).replace(/\/+$/u, "") || "/";
const navigation = [
	{ path: "/docs/", label: "Docs" },
	{ path: "/examples/", label: "Examples" },
	{ path: "/manual/", label: "Manual" },
];

function isCurrent(path: string): boolean {
	if (!path.startsWith("/")) return false;
	const normalized = path.replace(/\/+$/u, "") || "/";
  return normalized === "/docs"
    ? currentPath === "/docs" || currentPath.startsWith("/docs/")
    : normalized === "/manual"
      ? currentPath === "/manual" || currentPath.startsWith("/manual/")
      : normalized === "/examples"
        ? currentPath === "/examples" || currentPath.startsWith("/examples/")
        : currentPath === normalized;
}
---

<div class="starlight-header-content">
	<a class="starlight-brand" href={sitePath("/")} aria-label="EASEL.js home">EASEL.js</a>
  <nav class="starlight-global-nav" aria-label="Primary">
    <ul>
      {
				navigation.map(({ path, label }) => (
					<li>
						<a
							href={path.startsWith("/") ? sitePath(path) : path}
							aria-current={isCurrent(path) ? "page" : undefined}
							rel={path.startsWith("http") ? "noreferrer" : undefined}
            >
              {label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
  <div class="starlight-search">
    <Search />
  </div>
</div>
