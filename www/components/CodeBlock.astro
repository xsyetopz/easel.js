---
import hljs from "highlight.js/lib/core";
import type { LanguageFn } from "highlight.js";
import javascript from "highlight.js/lib/languages/javascript";
import typescript from "highlight.js/lib/languages/typescript";

hljs.registerLanguage("javascript", javascript as LanguageFn);
hljs.registerLanguage("typescript", typescript as LanguageFn);

interface Props {
	code: string;
	language?: string;
}

const { code, language = "javascript" } = Astro.props as Props;
const escapeHtml = (value: string) =>
	value
		.replaceAll("&", "&amp;")
		.replaceAll("<", "&lt;")
		.replaceAll(">", "&gt;")
		.replaceAll('"', "&quot;")
		.replaceAll("'", "&#39;");
const highlighted = language === "plaintext" ? escapeHtml(code) : hljs.highlight(code, { language, ignoreIllegals: true }).value;
---

<pre class="code-block hljs"><code set:html={highlighted}></code></pre>
