---
interface Props {
	className?: string;
	href?: string;
	icon: string;
	text: string;
	title: string;
}

const { className, href, icon, text, title } = Astro.props;
const classes = ["feature-card", className].filter(Boolean).join(" ");
---

{
	href ? (
		<a href={href} class={classes}>
			<div class="feature-card-title">
				<i class={icon} aria-hidden="true"></i>
				<h3>{title}</h3>
			</div>
			<p class="feature-card-copy">{text}</p>
		</a>
	) : (
		<article class={classes}>
			<div class="feature-card-title">
				<i class={icon} aria-hidden="true"></i>
				<h3>{title}</h3>
			</div>
			<p class="feature-card-copy">{text}</p>
		</article>
	)
}
