{
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext"],
    "strict": true
  },
  "imports": {
    "@xsyetopz/easel": "jsr:@xsyetopz/easel@0.8.0"
  },
  "tasks": {
    "check": "deno check src/main.ts",
    "build": "deno bundle --platform browser -o dist/main.js src/main.ts",
    "serve": "deno run --allow-net --allow-read jsr:@std/http@1/file-server ."
  }
}
