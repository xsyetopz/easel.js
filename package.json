{
  "name": "@xsyetopz/easel",
  "version": "0.6.1",
  "description": "Canvas2D software renderer and CPU rasterizer with a THREE.js-style scene graph API",
  "type": "module",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.es.js",
      "require": "./dist/index.cjs"
    },
    "./src/*": "./src/*"
  },
  "files": [
    "dist",
    "src",
    "package.json",
    "README.md",
    "LICENSE"
  ],
  "directories": {
    "tests": "tests"
  },
  "scripts": {
    "dev": "bun run docs:generate && astro dev",
    "dev:astro": "astro dev",
    "build": "bun run clean:declarations && vite build && bun run build:types",
    "build:types": "tsc -p tsconfig.build.json",
    "preview": "astro preview",
    "www:build": "bun run docs:generate && astro build",
    "bench": "bun benchmarks/render-suite.mjs",
    "bench:compare": "bun benchmarks/compare-results.mjs",
    "test": "bun test",
    "test:run": "bun test",
    "typecheck": "bunx tsc --noEmit",
    "version:check": "bun run scripts/check-version.mjs",
    "version": "bun run scripts/version.mjs",
    "deps:check": "bun run scripts/check-dependencies.mjs",
    "biome:check": "biome check . --error-on-warnings --max-diagnostics 16384",
    "biome:fix": "biome check . --write --max-diagnostics 16384",
    "biome:format": "biome format . --write --max-diagnostics 16384",
    "biome:lint": "biome lint . --max-diagnostics 16384",
    "biome:lint:fix": "biome lint . --write --max-diagnostics 16384",
    "pack:verify": "bun run build && bun run scripts/verify-package.mjs",
    "release:check": "bun install --frozen-lockfile && bun run version:check && bun run deps:check && bun run biome:check && bun run typecheck && bun run typecheck:tests && bun run typecheck:website && bun run tests:no-any && bun run examples:source-parity && bun run test:run && bun run www:build && bun run pack:verify",
    "release": "bun run scripts/release.mjs",
    "prepack": "bun run build",
    "prepublishOnly": "bun run release:check",
    "jsr:clean": "bun run clean:declarations",
    "jsr:build": "bun run jsr:clean && tsc -p tsconfig.jsr.json",
    "clean:declarations": "find src \\( -name '*.d.ts' ! -name 'globals.d.ts' -o -name '*.d.ts.map' \\) | xargs rm -f",
    "typecheck:tests": "tsc -p tests/tsconfig.json --noEmit --pretty false",
    "typecheck:website": "tsc -p www/tsconfig.json --noEmit --pretty false",
    "tests:no-any": "bun run scripts/check-no-test-any.mjs",
    "examples:source-parity": "bun run scripts/check-example-source-parity.mjs",
    "docs:generate": "bun run scripts/generate-starlight-docs.mjs",
    "docs:build": "bun run docs:generate && astro build",
    "docs:start": "bun run docs:generate && astro dev --open /docs/"
  },
  "keywords": [
    "3d",
    "2d",
    "animation",
    "babylonjs-alternative",
    "browser-canvas",
    "browser-rasterizer",
    "canvas-api",
    "canvas",
    "canvas2d",
    "canvas-renderer",
    "computer-graphics",
    "creative-coding",
    "cpu-canvas",
    "cpu-rasterizer",
    "cpu-renderer",
    "createjs",
    "createjs-alternative",
    "createjs-easeljs-alternative",
    "createjs-easeljs",
    "display-object",
    "easeljs",
    "easeljs-graphics",
    "easeljs-graphics-library",
    "easeljs-renderer",
    "easeljs-shape",
    "easeljs-sprite",
    "easeljs-stage",
    "easeljs-ticker",
    "easel",
    "easel.js",
    "easeljs-alternative",
    "easeljs-replacement",
    "graphics",
    "html5",
    "javascript",
    "js-canvas",
    "js-rendering",
    "library",
    "node-canvas-alternative",
    "polygon",
    "png",
    "rasterization",
    "render",
    "renderer",
    "rendering",
    "scene-graph",
    "software-canvas",
    "rasterize",
    "rasterizer",
    "software-renderer",
    "three-js",
    "threejs",
    "threejs-graphics",
    "threejs-alternative"
  ],
  "author": {
    "name": "xsyetopz"
  },
  "publisher": "xsyetopz",
  "license": "ISC",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/xsyetopz/easel.js.git"
  },
  "bugs": {
    "url": "https://github.com/xsyetopz/easel.js/issues"
  },
  "homepage": "https://easeljs.org",
  "readme": "README.md",
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/starlight": "^0.41.6",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.1.2",
    "astro": "^7.1.6",
    "bun-types": "^1.3.14",
    "highlight.js": "^11.11.1",
    "jsdom": "^30.0.1",
    "sass": "^1.102.0",
    "three": "^0.185.1",
    "typescript": "^7.0.2",
    "typescript-compiler-api": "npm:typescript@^7.0.2",
    "vite": "^8.2.0"
  },
  "dependencies": {},
  "unpkg": "./dist/index.umd.js",
  "jsdelivr": "./dist/index.umd.js",
  "patchedDependencies": {
    "@volar/kit@2.4.28": "patches/@volar%2Fkit@2.4.28.patch",
    "@astrojs/language-server@2.16.11": "patches/@astrojs%2Flanguage-server@2.16.11.patch"
  }
}
