{
  "name": "@xsyetopz/easel",
  "version": "0.7.0",
  "description": "Canvas2D software renderer and CPU rasterizer with a scene graph API",
  "type": "module",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.es.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "src",
    "package.json",
    "README.md",
    "LICENSE"
  ],
  "directories": {
    "tests": "tests"
  },
  "scripts": {
    "dev": "bun run docs:generate && astro dev",
    "build": "bun run clean:declarations && vite build && bun run build:types",
    "build:types": "tsc -p tsconfig.build.json",
    "preview": "astro preview",
    "www:build": "bun run docs:generate && astro build",
    "bench": "bun benchmarks/render-suite.mjs",
    "bench:compare": "bun benchmarks/compare-results.mjs",
    "typecheck": "bunx tsc --noEmit",
    "version:check": "python3 -m scripts check-version",
    "version": "python3 -m scripts version",
    "deps:check": "python3 -m scripts check-dependencies",
    "biome:lint": "biome lint . --max-diagnostics 16384",
    "biome:lint:fix": "biome lint . --write --max-diagnostics 16384",
    "biome:format": "biome format . --write --max-diagnostics 16384",
    "pack:verify": "bun run build && python3 -m scripts verify-package",
    "release:check": "bun install --frozen-lockfile && bun run version:check && bun run deps:check && bun run biome:lint && bun run api:check-modern && bun run api:compare:check && bun run docs:check-public && bun run docs:generate && bun run docs:check-source && bun run typecheck && bun run typecheck:tests && bun run typecheck:website && bun run tests:no-any && bun run examples:catalog && bun test && bun run www:build && bun run pack:verify && bun run jsr:dry-run",
    "release": "python3 -m scripts release",
    "prepack": "bun run build",
    "prepublishOnly": "bun run release:check",
    "jsr:build": "bun run clean:declarations && tsc -p tsconfig.jsr.json",
    "jsr:dry-run": "bun run jsr:build && jsr publish --dry-run --allow-dirty; status=$?; bun run clean:declarations; exit $status",
    "jsr:publish": "bun run jsr:build && jsr publish",
    "clean:declarations": "find src \\( -name '*.d.ts' ! -name 'globals.d.ts' -o -name '*.d.ts.map' \\) | xargs rm -f",
    "typecheck:tests": "tsc -p tests/tsconfig.json --noEmit --pretty false",
    "typecheck:website": "tsc -p www/tsconfig.json --noEmit --pretty false",
    "tests:no-any": "python3 -m scripts check-no-test-any",
    "examples:catalog": "python3 -m scripts check-example-catalog",
    "docs:generate": "bun scripts/generate-starlight-docs.ts",
    "docs:check-source": "bun scripts/generate-starlight-docs.ts --check",
    "api:compare": "bun scripts/generate-api-comparison.ts",
    "api:compare:check": "bun scripts/generate-api-comparison.ts --check",
    "api:check-modern": "bun scripts/check-modern-api.ts",
    "docs:check-public": "bun scripts/check-public-jsdoc.ts"
  },
  "keywords": [
    "3d",
    "2d",
    "animation",
    "babylonjs-alternative",
    "browser-canvas",
    "browser-rasterizer",
    "canvas-api",
    "canvas",
    "canvas2d",
    "canvas-renderer",
    "computer-graphics",
    "creative-coding",
    "cpu-canvas",
    "cpu-rasterizer",
    "cpu-renderer",
    "createjs",
    "createjs-alternative",
    "createjs-easeljs-alternative",
    "createjs-easeljs",
    "display-object",
    "easeljs",
    "easeljs-graphics",
    "easeljs-graphics-library",
    "easeljs-renderer",
    "easeljs-shape",
    "easeljs-sprite",
    "easeljs-stage",
    "easeljs-ticker",
    "easel",
    "easel.js",
    "easeljs-alternative",
    "easeljs-replacement",
    "graphics",
    "html5",
    "javascript",
    "js-canvas",
    "js-rendering",
    "library",
    "node-canvas-alternative",
    "polygon",
    "png",
    "rasterization",
    "render",
    "renderer",
    "rendering",
    "scene-graph",
    "software-canvas",
    "rasterize",
    "rasterizer",
    "software-renderer"
  ],
  "author": {
    "name": "xsyetopz"
  },
  "publisher": "xsyetopz",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/xsyetopz/easel.js.git"
  },
  "bugs": {
    "url": "https://github.com/xsyetopz/easel.js/issues"
  },
  "homepage": "https://easeljs.org",
  "readme": "README.md",
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/starlight": "^0.41.7",
    "@biomejs/biome": "^2.5.8",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.2.0",
    "astro": "^7.2.2",
    "bun-types": "^1.3.14",
    "jsdom": "^30.0.1",
    "jsr": "0.14.3",
    "sass": "^1.102.0",
    "shiki": "^4.4.3",
    "three": "^0.185.1",
    "typescript": "^7.0.2",
    "typescript-api": "npm:typescript@^6.0.3",
    "typescript-compiler-api": "npm:typescript@^7.0.2",
    "vite": "^8.2.1"
  },
  "unpkg": "./dist/index.umd.js",
  "jsdelivr": "./dist/index.umd.js",
  "patchedDependencies": {
    "@volar/kit@2.4.28": "patches/@volar%2Fkit@2.4.28.patch",
    "@astrojs/language-server@2.16.11": "patches/@astrojs%2Flanguage-server@2.16.11.patch"
  }
}
