{
    "name": "easel",
    "version": "0.1.0",
    "description": "Legacy JavaScript 3D library",
    "private": true,
    "type": "module",
    "main": "./dist/index.umd.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.es.js",
            "require": "./dist/index.umd.js"
        },
        "./src/*": "./src/*"
    },
    "files": [
        "dist",
        "src",
        "package.json",
        "README.md",
        "LICENSE"
    ],
    "directories": {
        "tests": "tests"
    },
    "scripts": {
        "dev": "vite --config playground/vite.config.js",
        "build": "vite build && bun run build:types",
        "build:types": "tsc -p tsconfig.build.json",
        "preview": "vite preview",
        "playground:build": "vite build --config playground/vite.config.js",
        "test": "vitest",
        "test:run": "vitest run",
        "typecheck": "bunx tsc --noEmit",
        "biome:check": "bunx biome check . --write --max-diagnostics 16384",
        "biome:format": "bunx biome format . --write --max-diagnostics 16384",
        "biome:lint": "bunx biome lint . --write --max-diagnostics 16384"
    },
    "keywords": [
        "easel",
        "easel.ts",
        "typescript",
        "3d",
        "canvas",
        "svg",
        "html5"
    ],
    "author": {
        "name": "xsyetopz"
    },
    "publisher": "xsyetopz",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/xsyetopz/easel.js.git"
    },
    "bugs": {
        "url": "https://github.com/xsyetopz/easel.js/issues"
    },
    "homepage": "https://github.com/xsyetopz/easel.js",
    "readme": "README.md",
    "devDependencies": {
        "@biomejs/biome": "2.4.8",
        "@mantine/code-highlight": "^8.3.18",
        "@mantine/core": "^8.3.18",
        "@mantine/hooks": "^8.3.18",
        "@tabler/icons-react": "^3.40.0",
        "@types/bun": "1.3.11",
        "@vitejs/plugin-react": "^6.0.1",
        "@vitest/ui": "4.1.0",
        "bun-types": "1.3.11",
        "jsdom": "29.0.0",
        "postcss": "^8.5.8",
        "postcss-preset-mantine": "^1.18.0",
        "react": "^19.2.4",
        "react-dom": "^19.2.4",
        "three": "0.183.2",
        "vite": "8.0.0",
        "vitest": "4.1.0"
    }
}
