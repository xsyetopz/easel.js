{
    "name": "@xsyetopz/easel",
    "version": "0.4.0",
    "description": "Legacy JavaScript 3D library with a THREE.js-compatible scene graph API",
    "type": "module",
    "main": "./dist/index.umd.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.es.js",
            "require": "./dist/index.umd.js"
        },
        "./src/*": "./src/*"
    },
    "files": [
        "dist",
        "src",
        "package.json",
        "README.md",
        "LICENSE"
    ],
    "directories": {
        "tests": "tests"
    },
    "scripts": {
        "dev": "vite --config playground/vite.config.ts",
        "build": "vite build && bun run build:types",
        "build:types": "tsc -p tsconfig.build.json",
        "preview": "vite preview",
        "playground:build": "vite build --config playground/vite.config.ts",
        "test": "vitest",
        "test:run": "vitest run",
        "typecheck": "bunx tsc --noEmit",
        "biome:check": "bunx biome check . --write --max-diagnostics 16384",
        "biome:format": "bunx biome format . --write --max-diagnostics 16384",
        "biome:lint": "bunx biome lint . --write --max-diagnostics 16384",
        "jsr:clean": "find src \\( -name '*.d.ts' ! -name 'globals.d.ts' -o -name '*.d.ts.map' \\) | xargs rm -f",
        "jsr:build": "bun run jsr:clean && tsc -p tsconfig.jsr.json",
        "jsr:publish": "bun run jsr:build && bunx jsr publish --allow-slow-types"
    },
    "keywords": [
        "3d",
        "canvas",
        "canvas2d",
        "easel",
        "easel.js",
        "html5",
        "javascript",
        "polygon",
        "png",
        "render",
        "renderer",
        "rendering",
        "rasterize",
        "rasterizer"
    ],
    "author": {
        "name": "xsyetopz"
    },
    "publisher": "xsyetopz",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/xsyetopz/easel.js.git"
    },
    "bugs": {
        "url": "https://github.com/xsyetopz/easel.js/issues"
    },
    "homepage": "https://github.com/xsyetopz/easel.js",
    "readme": "README.md",
    "devDependencies": {
        "@biomejs/biome": "^2.4.8",
        "@mantine/code-highlight": "^8.3.18",
        "@mantine/core": "^8.3.18",
        "@mantine/hooks": "^8.3.18",
        "@tabler/icons-react": "^3.40.0",
        "@types/bun": "^1.3.11",
        "@vitejs/plugin-react": "^6.0.1",
        "@vitest/ui": "^4.1.1",
        "bun-types": "^1.3.11",
        "highlight.js": "^11.11.1",
        "jsdom": "^29.0.1",
        "postcss": "^8.5.8",
        "postcss-preset-mantine": "^1.18.0",
        "react": "^19.2.4",
        "react-dom": "^19.2.4",
        "three": "^0.183.2",
        "typescript": "5.9.3",
        "vite": "^8.0.2",
        "vitest": "^4.1.1"
    },
    "dependencies": {}
}
